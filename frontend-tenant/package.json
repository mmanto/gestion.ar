{
  "name": "frontend-tenant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:staff": "VITE_TARGET=staff vite --mode dev",
    "dev:client": "VITE_TARGET=client vite --mode dev",
    "build": "tsc -b && vite build --mode prod",
    "build:staff": "VITE_TARGET=staff CAPACITOR_BUILD=1 tsc -b && vite build --mode capacitor",
    "build:client": "VITE_TARGET=client CAPACITOR_BUILD=1 tsc -b && vite build --mode capacitor",
    "sync:staff": "VITE_TARGET=staff npx cap sync",
    "sync:client": "VITE_TARGET=client npx cap sync",
    "open:android:staff": "VITE_TARGET=staff npx cap open android",
    "open:ios:staff": "VITE_TARGET=staff npx cap open ios",
    "open:android:client": "VITE_TARGET=client npx cap open android",
    "open:ios:client": "VITE_TARGET=client npx cap open ios",
    "lint": "eslint .",
    "preview": "vite preview --mode prod"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
