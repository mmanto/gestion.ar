{
	"appId": "ius.intellify.pro",
	"appName": "ius Staff",
	"webDir": "dist",
	"server": {
		"cleartext": true,
		"androidScheme": "http"
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"backgroundColor": "#25357a",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#25357a"
		}
	}
}
