# .env.capacitor — Variables para builds Capacitor (APK/IPA)
# Vite carga este archivo con --mode capacitor.
# VITE_API_URL NO se define aca — se inyecta desde el entorno
# (stack.dev build-android ... http://IP:8000) para que cada build
# pueda apuntar a un backend distinto (emulador vs dispositivo fisico).

VITE_APP_NAME=Asistente
VITE_TENANT_APP_NAME=Backoffice
