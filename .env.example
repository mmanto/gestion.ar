# Variables para docker-compose.prod.yml
# Copiar a .env y completar con los valores reales:
#   cp .env.example .env

REGISTRY_IMAGE=registry.gitlab.com/NAMESPACE/PROJECT
IMAGE_TAG=latest

# Variables para docker-compose.tenants.prod.yml — un TENANT_ID_<SLUG> por
# tenant con dominio propio dado de alta. El tenant_id se obtiene creando el
# tenant desde el panel admin (ver docs/ops/DEPLOYMENT.md).
TENANT_ID_IUS=
