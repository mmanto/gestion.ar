# .env.example — Plantilla de variables de entorno
#
# Copiar a .env.dev (desarrollo) o .env.prod (producción) y completar los
# valores reales. Ver ENV.md para el detalle de cada variable.
#
# NOTA: MongoDB (legacy, no usado) fue reemplazado por Postgres — ver ADR-006.
# Postgres y Redis exponen puertos alternativos en el HOST para evitar
# colisiones con servicios locales existentes:
#   Postgres → host:5433  (interno Docker: postgres:5432)
#   Redis    → host:6380  (interno Docker: redis:6379)

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Docker Compose / Registry (solo .env.prod — deploy.sh / docker-compose.prod.yml) ──
REGISTRY_IMAGE=registry.gitlab.com/NAMESPACE/PROJECT
IMAGE_TAG=latest

# ── Base de datos (Postgres) ───────────────────────────────────────────────────
DB_NAME=gestionar
DB_USER=gestionar_user
DB_PASSWORD=your_db_password
REDIS_URL=redis://redis:6379

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PATH=/app/chroma_db

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=claude
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M:latest
OLLAMA_TIMEOUT=120

# ── URLs públicas ─────────────────────────────────────────────────────────────
# WEBHOOK_BASE_URL: URL pública del BACKEND, usada para callbacks de
# WhatsApp/Telegram (Meta/Telegram deben poder llegar a ella).
# FRONTEND_URL: URL pública del FRONTEND, usada para el link "Copiar link del
# chat" y redirects post-OAuth. Son dominios distintos en producción.
WEBHOOK_BASE_URL=https://api.tudominio.com
FRONTEND_URL=https://tudominio.com

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_token_here
WHATSAPP_PHONE_ID=your_phone_id
WEBHOOK_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_APP_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_WEBHOOK_SECRET=your_secret_token_here

# ── PWA / VAPID ───────────────────────────────────────────────────────────────
# Generar con: scripts/generarte_vapid_keys.sh
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Push nativo staff (apps Android/iOS, ver docs/dev/MOBILE.md) ─────────────
# Opcional: solo si hay una app nativa con push FCM/APNs. Ruta al JSON de
# Firebase Admin SDK (Project Settings → Service Accounts → Generate new
# private key), montado en el contenedor como archivo (nunca commitear).
# FCM_CREDENTIALS_PATH=/app/secrets/firebase-credentials.json

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost

# ── Login + integraciones (Google/Microsoft) vía Nango self-hosted ───────────
# Nango maneja el OAuth y custodia/refresca los tokens. Las credenciales OAuth
# de Google/Microsoft se configuran en el dashboard de Nango, no acá.
# Con Docker (ver docker-compose.yml, red externa `nango_network` compartida
# con devbout-oauth/deploy/nango): NANGO_HOST=http://nango-server:8080
# Corriendo el backend directo en el host (sin Docker): NANGO_HOST=http://localhost:3003
NANGO_HOST=http://nango-server:8080
NANGO_SECRET_KEY=
# Clave para firmar el login nonce (openssl rand -hex 32)
STATE_SIGNING_KEY=
# Clave Fernet para credenciales propias en MongoDB/Postgres (openssl rand -hex 32)
ENCRYPTION_KEY=

# ── devbout-appointments (microservicio genérico de turnos) ─────────────────
APPOINTMENTS_API_BASE_URL=https://appointments.intellify.pro
APPOINTMENTS_API_KEY=
APPOINTMENTS_WEBHOOK_SECRET=
# Remote de Module Federation (panel + widgets de chat) -- build arg del
# frontend, ver docker-compose.prod.yml/frontend/Dockerfile. Sin esto el
# build de prod cae al fallback de dev (localhost:5180) y el chat/panel de
# turnos rompe con ERR_CONNECTION_REFUSED en el browser.
VITE_APPOINTMENTS_REMOTE_URL=https://appointments-widgets.intellify.pro/remoteEntry.js

# ── Tenants con dominio propio (docker-compose.tenants.prod.yml, solo .env.prod) ──
# Un TENANT_ID_<SLUG> por tenant con dominio propio dado de alta. El tenant_id
# se obtiene creando el tenant desde el panel admin (ver docs/ops/DEPLOYMENT.md).
TENANT_ID_IUS=

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Variables con prefijo VITE_ se exponen al navegador / se hornean en el build.
VITE_API_URL=http://localhost:8000
# Nombre de marca de cada app — deben tener claves distintas porque ambas apps
# leen este mismo archivo (ver frontend/vite.config.ts y frontend-tenant/vite.config.ts).
VITE_APP_NAME=Asistente
VITE_TENANT_APP_NAME=Backoffice
VITE_NANGO_CONNECT_URL=http://localhost:3009
VITE_NANGO_API_URL=http://localhost:3003


TENANT_ID_ERMA=
TENANT_ID_LABORALIA=
TENANT_ID_PROPTECH=
TENANT_ID_PACHOTESAYUDA=
TENANT_ID_IPACHOTESAYUDA=

# ── Identidad nativa por tenant (APK Android, scripts/stack-*.sh build-android) ──
# applicationId propio por tenant: apps Android independientes, coexisten
# instaladas, cada una con su propio proyecto Firebase para push (ver
# frontend-tenant/tenant-assets/<slug>/README.md para google-services.json).
# Vacío = ese tenant todavía no tiene build-android habilitado.
# IMPORTANTE: scripts/stack-dev.sh y stack-prod.sh hacen `source` de este
# archivo directo en bash (para poder leer estas variables en
# cmd_build_android) — a diferencia del resto del stack, que carga el .env
# vía `docker compose --env-file` (sin reglas de shell). Todo valor de
# TENANT_APPNAME_<SLUG> que tenga espacios (van a tenerlos, son nombres de
# app) DEBE ir entre comillas, o el `source` rompe con un críptico "orden
# no encontrada" en vez de un error claro.
TENANT_APPID_IUS=ius.intellify.pro
TENANT_APPNAME_IUS="ius"
TENANT_BRANDCOLOR_IUS=#25357a
# Dominio público del frontend web del tenant, horneado en el APK como
# VITE_TENANT_PUBLIC_URL. En la app nativa las llamadas van directo al
# backend (VITE_API_URL), así que getPublicUrl() no puede derivar el dominio
# del tenant del Host de la request (devolvería el del API, ej.
# api.intellify.pro). Si está seteado, el link de chat ("Compartir" / "Mi
# link de chat") usa esta base; sin él se mantiene la derivación por Host
# (correcta en web, incorrecta en APK). Ej: TENANT_PUBLIC_URL_IUS=https://ius.intellify.pro
TENANT_PUBLIC_URL_IUS=

TENANT_APPID_ERMA=
TENANT_APPNAME_ERMA=
TENANT_BRANDCOLOR_ERMA=

TENANT_APPID_LABORALIA=
TENANT_APPNAME_LABORALIA=
TENANT_BRANDCOLOR_LABORALIA=

TENANT_APPID_PROPTECH=
TENANT_APPNAME_PROPTECH=
TENANT_BRANDCOLOR_PROPTECH=
